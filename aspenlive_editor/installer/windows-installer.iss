; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#ifndef VERSION
  #define VERSION "0.0.0"
#endif
#ifndef ONLY_64_BIT
  #define ONLY_64_BIT "x64"
#endif
#ifndef PY_EXE_DIR
  #define PY_EXE_DIR "exe.mingw-3.8"
#endif

#define MyAppName "AspenLive"
#define MyAppProjectFileDesc "AspenLive Project File"
#define MyAppPublisher "The Biggest Studios"
#define MyAppExeName "aspenlive.exe"

#include "isportable.iss"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={code:GetAppId|{{B7E2C4A1-6F09-4C3D-8A55-1D0E9F2A6C40}}
AppName=AspenLive
AppVersion={#VERSION}
AppVerName={#MyAppName} {#VERSION}
VersionInfoVersion={#VERSION}
AppPublisher={#MyAppPublisher}
AppCopyright=Copyright 2026 {#MyAppPublisher}
DefaultDirName={code:GetDefaultDirName|AspenLive}
DisableProgramGroupPage=yes
LicenseFile=..\COPYING
OutputBaseFilename=AspenLive-{#VERSION}-x64
ArchitecturesInstallIn64BitMode={#ONLY_64_BIT}
ArchitecturesAllowed={#ONLY_64_BIT}
ChangesAssociations=not PortableCheck
ChangesEnvironment=not PortableCheck
Compression=lzma
SolidCompression=yes
WizardStyle=modern
WizardImageFile=wizard-side.bmp
WizardSmallImageFile=wizard-logo.bmp
SetupIconFile=..\xdg\aspenlive.ico
UsePreviousLanguage=no
Uninstallable=not PortableCheck
UninstallDisplayIcon={app}\{#MyAppExeName}
SignedUninstaller=no
SignedUninstallerDir=..\build\
PrivilegesRequiredOverridesAllowed=commandline
AllowNoIcons=yes

